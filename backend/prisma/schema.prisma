generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  DISABLED
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum DocStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  customers  Customer[]
  categories ProductCategory[]
  units      Unit[]
  products   Product[]
  warehouses Warehouse[]
  movements  StockMovement[]
  quotations Quotation[]
  orders     SalesOrder[]
  invoices   Invoice[]
  payments   Payment[]
  expenses   Expense[]
  auditLogs  AuditLog[]
  sequences  DocNumberSequence[]

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  email          String
  passwordHash   String     @map("password_hash")
  role           Role       @default(STAFF)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  audits           AuditLog[]
  quotations       Quotation[]    @relation("CreatedQuotations")
  salesOrders      SalesOrder[]   @relation("CreatedOrders")
  invoicesCreated  Invoice[]      @relation("CreatedInvoices")
  paymentsCreated  Payment[]      @relation("CreatedPayments")
  expensesCreated  Expense[]      @relation("CreatedExpenses")

  @@unique([organizationId, email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?
  taxNumber      String?        @map("tax_number")
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  orders       SalesOrder[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([organizationId])
  @@map("customers")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@map("product_categories")
}

model Unit {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  abbreviation   String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@map("units")
}

model Product {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  categoryId     String?       @map("category_id")
  unitId         String?       @map("unit_id")
  name           String
  sku            String
  salePrice      Decimal       @default(0) @map("sale_price")
  costPrice      Decimal       @default(0) @map("cost_price")
  taxRate        Decimal       @default(0) @map("tax_rate")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit        Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  movements   StockMovement[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  invoiceItems   InvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  location       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements   StockMovement[]

  @@unique([organizationId, name])
  @@map("warehouses")
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  productId      String       @map("product_id")
  warehouseId    String?      @map("warehouse_id")
  movementType   MovementType @map("movement_type")
  quantity       Decimal
  referenceType  String?      @map("reference_type")
  referenceId    String?      @map("reference_id")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([organizationId, productId])
  @@map("stock_movements")
}

model DocNumberSequence {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  prefix         String
  year           Int
  lastValue      Int      @default(0) @map("last_value")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix, year])
  @@map("doc_number_sequences")
}

model Quotation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  number         String
  customerId     String    @map("customer_id")
  status         DocStatus @default(DRAFT)
  issueDate      DateTime  @default(now()) @map("issue_date")
  expiryDate     DateTime? @map("expiry_date")
  subtotal       Decimal   @default(0)
  taxAmount      Decimal   @default(0) @map("tax_amount")
  totalAmount    Decimal   @default(0) @map("total_amount")
  notes          String?
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        QuotationItem[]
  createdBy    User?        @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  orders       SalesOrder[]

  @@unique([organizationId, number])
  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(uuid())
  quotationId String   @map("quotation_id")
  productId   String?  @map("product_id")
  description String?
  quantity    Decimal
  unitPrice   Decimal  @map("unit_price")
  taxRate     Decimal  @default(0) @map("tax_rate")
  lineTotal   Decimal  @map("line_total")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("quotation_items")
}

model SalesOrder {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  number         String
  quotationId    String?   @map("quotation_id")
  customerId     String    @map("customer_id")
  status         DocStatus @default(DRAFT)
  issueDate      DateTime  @default(now()) @map("issue_date")
  subtotal       Decimal   @default(0)
  taxAmount      Decimal   @default(0) @map("tax_amount")
  totalAmount    Decimal   @default(0) @map("total_amount")
  notes          String?
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation    Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items        SalesOrderItem[]
  createdBy    User?        @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  invoice      Invoice?

  @@unique([organizationId, number])
  @@map("sales_orders")
}

model SalesOrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String?  @map("product_id")
  description String?
  quantity    Decimal
  unitPrice   Decimal  @map("unit_price")
  taxRate     Decimal  @default(0) @map("tax_rate")
  lineTotal   Decimal  @map("line_total")

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sales_order_items")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  number         String
  orderId        String?        @unique @map("order_id")
  customerId     String         @map("customer_id")
  status         InvoiceStatus  @default(DRAFT)
  issueDate      DateTime       @default(now()) @map("issue_date")
  dueDate        DateTime?      @map("due_date")
  subtotal       Decimal        @default(0)
  taxAmount      Decimal        @default(0) @map("tax_amount")
  totalAmount    Decimal        @default(0) @map("total_amount")
  notes          String?
  createdById    String?        @map("created_by_id")
  postedAt       DateTime?      @map("posted_at")
  paidAt         DateTime?      @map("paid_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        SalesOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]
  createdBy    User?        @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  productId String?  @map("product_id")
  description String?
  quantity  Decimal
  unitPrice Decimal  @map("unit_price")
  taxRate   Decimal  @default(0) @map("tax_rate")
  lineTotal Decimal  @map("line_total")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  number         String
  invoiceId      String?       @map("invoice_id")
  customerId     String        @map("customer_id")
  amount         Decimal
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(CONFIRMED)
  reference      String?
  paidAt         DateTime      @default(now()) @map("paid_at")
  createdById    String?       @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId])
  @@map("payments")
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  amount         Decimal
  category       String?
  description    String?
  expenseDate    DateTime @default(now()) @map("expense_date")
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("expenses")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType])
  @@map("audit_logs")
}